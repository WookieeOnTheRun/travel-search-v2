# Template for travel_agent/main.env, the env file config.py checks first (after an explicit
# $TRAVEL_AGENT_ENV_FILE path). Copy it to travel_agent/main.env -- gitignored -- and fill in
# the values. Variables already set in the real process environment always take precedence over
# this file. A blank value (KEY=) means "use the default".
# NEVER paste a secret anywhere outside the gitignored main.env (not into chat, code, or any
# tracked file). Rotate a key with its provider if it is ever exposed.

# --- LLM (Ollama Cloud) -----------------------------------------------------------------
# Model used by every agent (request understanding, destination brainstorm, itinerary
# writing). Default: gemma4:cloud.
OLLAMA_MODEL=
# SDK host root -- the ollama-python client appends "/api/<endpoint>" itself, so this is
# https://ollama.com, NOT the "https://ollama.com/api/..." form in Ollama's curl examples
# (see config.py). Default: https://ollama.com.
OLLAMA_HOST=
# Secret. Bearer token for Ollama Cloud; create/rotate at https://ollama.com/settings/keys.
OLLAMA_API_KEY=""

# --- RapidAPI (flights, hotels, visas) -----------------------------------------------------
# Secret. One key for every RapidAPI host below. Without it, flight, hotel and visa results
# report "RAPIDAPI_KEY missing".
RAPIDAPI_KEY=""
# RapidAPI product hosts. Only the host is configurable -- endpoint paths are fixed, verified
# constants in code (see config.py). Booking.com covers flight and hotel search; the visa host
# handles entry-requirement lookups.
RAPIDAPI_BOOKING_HOST="booking-com15.p.rapidapi.com"
RAPIDAPI_VISA_HOST="visa-requirement.p.rapidapi.com"

# --- Geoapify (places) ---------------------------------------------------------------------
# Secret. Geoapify Places API key (free plan: https://www.geoapify.com/pricing) -- place data
# for destination discovery and sightseeing. Without it those checks report "unavailable".
GEOAPIFY_API_KEY=

# --- Optional extra travel endpoints ----------------------------------------------------
# Comma-separated URLs of your own JSON endpoints, queried for extra grounding snippets with
# the request text, destination, currency and locale as query params. Empty = none.
TRAVEL_API_ENDPOINTS=
# Secret. Sent as a Bearer token to TRAVEL_API_ENDPOINTS only (never to RapidAPI).
TRAVEL_API_KEY=

# --- Defaults ------------------------------------------------------------------------------
# Currency (ISO 4217) for hotel and flight prices.
DEFAULT_CURRENCY=USD
# Locale for result language (also sent lowercased as Booking.com's languagecode).
DEFAULT_LOCALE=en-US
# Passport country (ISO 3166-1 alpha-2) assumed for visa-requirement lookups.
DEFAULT_CITIZENSHIP_COUNTRY_CODE=US
# Read timeout in seconds for outbound HTTP calls (connects always time out after 5 s).
REQUEST_TIMEOUT_SECONDS=20

# --- Storage -------------------------------------------------------------------------------
# SQLite file for per-session itineraries and saved searches. Default: data/travel_sessions.db
# under the project root. Use a persistent disk in deployment, or a restart wipes them.
# SESSION_DB_PATH=
