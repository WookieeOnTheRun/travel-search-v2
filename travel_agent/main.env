# Local Foundry model config
MODEL_NAME=phi-4
MODEL_ENDPOINT=http://localhost:5273/v1
MODEL_API_KEY=local

# Duffel API (flights + accommodation/stays search -- see config.py and
# travel_agent/http_utils.py's duffel_headers()). Set this to a real token from your
# Duffel dashboard (test tokens start with "duffel_test_") before running the app --
# NEVER paste this value anywhere outside this gitignored local file (not into chat,
# not into code, not into any tracked file). Rotate on Duffel immediately if it is
# ever exposed.
DUFFEL_API_KEY=
DUFFEL_API_BASE_URL="https://api.duffel.com"
DUFFEL_API_VERSION="v2"

# RapidAPI key for all configured RapidAPI sources.
# NEVER paste this value anywhere outside this gitignored local file (not into chat,
# not into code, not into any tracked file). Rotate on RapidAPI if it is ever exposed.
RAPIDAPI_KEY=""

# RapidAPI source hosts. Only the host is configurable -- endpoint paths are fixed,
# verified constants in code (see config.py for why). Only used for cruise search and
# visa requirements now -- flights and hotel/accommodation search moved to the Duffel
# API above.
RAPIDAPI_TRIPADVISOR_HOST="tripadvisor16.p.rapidapi.com"
RAPIDAPI_VISA_HOST="visa-requirement.p.rapidapi.com"

# Optional extra (non-RapidAPI) travel endpoints
TRAVEL_API_ENDPOINTS=
TRAVEL_API_KEY=

# Optional defaults
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US
DEFAULT_CITIZENSHIP_COUNTRY_CODE=US
REQUEST_TIMEOUT_SECONDS=20
