# Ollama Cloud model config. OLLAMA_HOST is the SDK host root (the ollama-python client
# appends "/api/<endpoint>" itself), NOT the "https://ollama.com/api/..." form shown in
# Ollama's raw HTTP/curl examples -- see config.py for why.
# NEVER paste OLLAMA_API_KEY anywhere outside this gitignored local file (not into chat,
# not into code, not into any tracked file). Create/rotate it at https://ollama.com/settings/keys.
OLLAMA_MODEL=
OLLAMA_HOST=
OLLAMA_API_KEY=""

# RapidAPI key for all configured RapidAPI sources.
# NEVER paste this value anywhere outside this gitignored local file (not into chat,
# not into code, not into any tracked file). Rotate on RapidAPI if it is ever exposed.
RAPIDAPI_KEY=""

# RapidAPI source hosts. Only the host is configurable -- endpoint paths are fixed,
# verified constants in code (see config.py for why). Booking.com covers both flight and
# hotel/accommodation search; a separate host handles visa requirements.
RAPIDAPI_BOOKING_HOST="booking-com15.p.rapidapi.com"
RAPIDAPI_VISA_HOST="visa-requirement.p.rapidapi.com"

# Optional extra (non-RapidAPI) travel endpoints
TRAVEL_API_ENDPOINTS=
TRAVEL_API_KEY=

# Optional defaults
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US
DEFAULT_CITIZENSHIP_COUNTRY_CODE=US
REQUEST_TIMEOUT_SECONDS=20
