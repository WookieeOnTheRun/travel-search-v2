# Ollama Cloud model config. OLLAMA_HOST is the SDK host root (the ollama-python client
# appends "/api/<endpoint>" itself), NOT the "https://ollama.com/api/..." form shown in
# Ollama's raw HTTP/curl examples -- see config.py for why. Create OLLAMA_API_KEY at
# https://ollama.com/settings/keys. Never commit a real value here or paste it into chat/PRs/issues.
OLLAMA_MODEL=gemma4:cloud
OLLAMA_HOST=https://ollama.com
OLLAMA_API_KEY=

# RapidAPI key for all configured RapidAPI sources
RAPIDAPI_KEY=

# RapidAPI source endpoints/hosts (set to the exact endpoint+host from RapidAPI listings).
# Tripadvisor covers flight search, hotel/accommodation search, and cruise search; a separate
# host is used for visa requirements.
RAPIDAPI_TRIPADVISOR_HOST=

RAPIDAPI_VISA_HOST=

# Optional extra (non-RapidAPI) travel endpoints
TRAVEL_API_ENDPOINTS=
TRAVEL_API_KEY=

# Optional defaults
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US
DEFAULT_CITIZENSHIP_COUNTRY_CODE=US
REQUEST_TIMEOUT_SECONDS=20
