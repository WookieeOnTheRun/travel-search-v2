# Local Ollama model config
OLLAMA_MODEL=
OLLAMA_HOST=

# Duffel API (flights + accommodation/stays search). Get a test token (starts with
# duffel_test_) from your Duffel dashboard -- https://duffel.com/docs/api/overview/test-mode.
# Never commit a real value here or paste it into chat/PRs/issues.
DUFFEL_API_KEY=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2

# RapidAPI key for all configured RapidAPI sources
RAPIDAPI_KEY=

# RapidAPI source endpoints/hosts (set to the exact endpoint+host from RapidAPI listings).
# Only used for cruise search (Tripadvisor) and visa requirements -- flights and hotel/
# accommodation search now go through the Duffel API above.
RAPIDAPI_TRIPADVISOR_HOST=

RAPIDAPI_VISA_HOST=

# Optional extra (non-RapidAPI) travel endpoints
TRAVEL_API_ENDPOINTS=
TRAVEL_API_KEY=

# Optional defaults
DEFAULT_CURRENCY=USD
DEFAULT_LOCALE=en-US
DEFAULT_CITIZENSHIP_COUNTRY_CODE=US
REQUEST_TIMEOUT_SECONDS=20
